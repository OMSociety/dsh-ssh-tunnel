{
  "name": "dsh-ssh-tunnel",
  "version": "1.1.0",
  "description": "Multi-host SSH tunnel and SSHManager tool for DeepSeek Harness (project-scoped grants)",
  "type": "module",
  "license": "MIT",
  "author": "thirsty5034",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-ssh-tunnel.git"
  },
  "homepage": "https://github.com/OMSociety/dsh-ssh-tunnel#readme",
  "bugs": {
    "url": "https://github.com/OMSociety/dsh-ssh-tunnel/issues"
  },
  "contributors": [
    {
      "name": "OMSociety",
      "url": "https://github.com/OMSociety"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "cordis"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/smoke-test.mjs",
    "check": "node --check lib/index.js && node scripts/smoke-test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README_en.md",
    "cordis.patch.yml",
    "lib",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/lib/*.cjs",
    "scripts/portal-probe.mjs",
    "scripts/smoke-test.mjs",
    "scripts/sync-to-dsh.sh",
    "icon.svg",
    "locale/*.json"
  ]
}
