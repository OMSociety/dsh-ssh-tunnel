{
  "name": "dsh-ssh-tunnel",
  "version": "0.4.6",
  "description": "Multi-host SSH tunnel and SSHManager tool for DeepSeek Harness (project-scoped grants)",
  "type": "module",
  "license": "MIT",
  "author": "thirsty5034",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirsty5034/dsh-ssh-tunnel.git"
  },
  "homepage": "https://github.com/thirsty5034/dsh-ssh-tunnel#readme",
  "bugs": {
    "url": "https://github.com/thirsty5034/dsh-ssh-tunnel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "cordis",
    "better-sidebar",
    "dsh-better-sidebar"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1 <0.2.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/smoke-test.mjs",
    "check": "node --check lib/index.js && node scripts/smoke-test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.2.0",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "files": [
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "lib",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/portal-probe.mjs",
    "scripts/smoke-test.mjs",
    "scripts/sync-to-dsh.sh"
  ]
}
